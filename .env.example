# Copy to .env.local for local development. On Vercel, set these in
# Project Settings → Environment Variables.

# Public site URL (used for SEO metadata, sitemap and structured data).
# Optional on Vercel — the production domain is detected automatically.
NEXT_PUBLIC_SITE_URL=https://www.example.ca

# Checkout runs in demo mode (no payment taken) unless this is "false".
NEXT_PUBLIC_DEMO_MODE=true

# Catalogue + checkout provider: "mock" (sample catalogue) or "clover".
COMMERCE_PROVIDER=mock

# Clover — only needed when COMMERCE_PROVIDER=clover.
CLOVER_ENVIRONMENT=sandbox
CLOVER_MERCHANT_ID=
CLOVER_API_TOKEN=

# Image generation script only (npm run images). Never needed at runtime.
GEMINI_API_KEY=
